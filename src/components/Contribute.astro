---
import "../styles/contribute.css";
---
<section class="section" id="contribute" data-section="Contribute">
  <div class="poster reveal">
    <div class="poster-bg" aria-hidden="true"></div>
    <p class="poster-pre mono">cloudrs presents</p>
    <h2 class="poster-title">Open<br>Source</h2>
    <p class="poster-sub">an early, open lineup · featuring <em>you</em> on</p>
    <ul class="lineup">
      <li><b>Audio</b><span>HLS, gapless, seeking with symphonia &amp; cpal</span></li>
      <li><b>Platform</b><span>MPRIS, Now Playing, SMTC, packaging</span></li>
      <li><b>Translations</b><span>English first, built for every language</span></li>
      <li><b>Design</b><span>Components on the visual identity</span></li>
    </ul>
    <div class="poster-foot">
      <a class="btn btn-primary magnetic" href="https://github.com/pablozr/cloudrs/blob/master/CONTRIBUTING.md" target="_blank" rel="noopener"><span>Read CONTRIBUTING</span><svg class="ic"><use href="#i-arrow"/></svg></a>
      <p class="mono">MIT · small commits · English · doors open now</p>
    </div>
  </div>
</section>

---
import { asset, page } from "../lib/url.js";
import "../styles/footer.css";
---
<footer class="footer" data-section="Outro">
  <p class="footer-mark" aria-hidden="true">cloud<span>rs</span></p>
  <div class="footer-row">
    <div class="brand">
      <img src={asset("assets/logo.svg")} alt="" width="24" height="24"><span class="wordmark">cloud<span>rs</span></span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={page("download")}>Download</a>
      <a href="https://github.com/pablozr/cloudrs" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/pablozr/cloudrs/tree/master/docs" target="_blank" rel="noopener">Docs</a>
      <a href="https://github.com/pablozr/cloudrs/blob/master/docs/design/VISUAL-IDENTITY.md" target="_blank" rel="noopener">Design</a>
      <a href="https://github.com/pablozr/cloudrs/blob/master/LICENSE" target="_blank" rel="noopener">MIT License</a>
    </nav>
  </div>
  <p class="disclaimer">cloudrs is an unofficial client and is not affiliated with, endorsed or sponsored by SoundCloud. It streams what SoundCloud already makes available to you: it does not download tracks, remove ads or unlock paid content. All trademarks belong to their owners.</p>
</footer>

<script>
  import "../scripts/footer.js";
</script>

---
import "../styles/keys.css";
---
<section class="section" id="keys" data-section="Keyboard">
  <header class="section-head center reveal">
    <p class="label">Keyboard first</p>
    <h2>Your hands stay home.</h2>
    <p class="muted">Go on, press them. They light up here too.</p>
  </header>
  <div class="keys">
    <div class="keycombo reveal">
      <div class="caps"><span class="cap" data-key="Control">Ctrl</span><span class="cap" data-key="k">K</span></div>
      <p><b>Search everything</b><span>or <kbd>/</kbd>, from any screen</span></p>
    </div>
    <div class="keycombo reveal" style="--d:1">
      <div class="caps"><span class="cap" data-key="Alt">Alt</span><span class="cap" data-key="ArrowLeft">←</span><span class="cap" data-key="ArrowRight">→</span></div>
      <p><b>Back and forward</b><span>through every screen you opened</span></p>
    </div>
    <div class="keycombo reveal" style="--d:2">
      <div class="caps"><span class="cap" data-key="Control">Ctrl</span><span class="cap" data-key="v">V</span></div>
      <p><b>Paste a link, open it</b><span>a SoundCloud URL or a Jam invite, in search</span></p>
    </div>
    <div class="keycombo reveal" style="--d:3">
      <div class="caps"><span class="cap cap-wide" data-key=" ">Space</span></div>
      <p><b>Play, pause</b><span>on this page today; in the app with M4</span></p>
    </div>
  </div>
</section>

<script>
  import "../scripts/keys.js";
</script>

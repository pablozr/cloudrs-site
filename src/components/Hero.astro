---
import { page } from "../lib/url.js";
import "../styles/hero.css";
---
<section class="hero" id="top" data-section="Intro">
  <canvas class="scene" id="scene" aria-hidden="true"></canvas>
  <div class="hero-copy">
    <a class="pill-badge reveal" href={page("download")}>
      <span class="live-dot"></span>
      <span>0.1 beta is out · Windows installer</span>
      <svg class="ic"><use href="#i-arrow"/></svg>
    </a>
    <h1 class="display reveal" style="--d:1">
      <span class="line"><span>Listen at</span></span>
      <span class="line"><span class="grad-text">120&nbsp;fps.</span></span>
    </h1>
    <p class="lede reveal" style="--d:2">
      <b>cloudrs</b> is a native, open source SoundCloud client for your desktop.
      No Electron, no webview: drawn on the GPU with GPUI, decoded in Rust.
    </p>
    <div class="cta-row reveal" style="--d:3">
      <a class="btn btn-primary magnetic" href={page("download")} data-download-cta>
        <svg class="ic"><use href="#i-download"/></svg><span>Download</span>
      </a>
      <a class="btn btn-secondary magnetic" href="https://github.com/pablozr/cloudrs" target="_blank" rel="noopener">
        <svg class="ic"><use href="#i-star"/></svg><span>Star on GitHub</span>
      </a>
    </div>
  </div>
  <button class="disc-hit" id="disc-play" aria-label="Play the live mix generated by this page" data-tip="Play the live mix"></button>
  <p class="now-pill mono"><span class="dot"></span><span id="disc-state">press play</span><span class="sep">·</span><span>112 BPM</span><span class="sep opt">·</span><span class="opt">A minor · live synth</span><span class="sep">·</span><kbd>Space</kbd></p>
</section>

<script>
  import "../scripts/hero.js";
</script>

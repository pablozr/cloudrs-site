---
import "../styles/numbers.css";
---
<section class="section" id="numbers" data-section="Numbers">
  <div class="stats">
    <div class="stat reveal"><p class="stat-num mono"><span class="pre">&lt;</span><span class="count" data-to="100">0</span><span class="unit">MB</span></p><p class="stat-label">RAM while playing, the target</p></div>
    <div class="stat reveal" style="--d:1"><p class="stat-num mono"><span class="count" data-to="120">0</span><span class="unit">fps</span></p><p class="stat-label">for every hover, click and scroll</p></div>
    <div class="stat reveal" style="--d:2"><p class="stat-num mono"><span class="count" data-to="0">0</span></p><p class="stat-label">Electron, webviews or cloudrs servers</p></div>
    <div class="stat reveal" style="--d:3"><p class="stat-num mono"><span class="count" data-to="3">0</span><span class="unit">OS</span></p><p class="stat-label">Linux, macOS and Windows</p></div>
  </div>
</section>

<script>
  import "../scripts/numbers.js";
</script>
